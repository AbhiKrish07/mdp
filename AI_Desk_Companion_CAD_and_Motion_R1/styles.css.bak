/* AI Desk Companion CAD Suite - Design System & Styles */
:root {
  --bg-primary: #070a11;
  --bg-secondary: #0d1322;
  --bg-surface: rgba(15, 23, 42, 0.75);
  --bg-surface-hover: rgba(30, 41, 59, 0.85);
  --bg-surface-active: rgba(51, 65, 85, 0.9);
  --border-subtle: rgba(255, 255, 255, 0.08);
  --border-accent: rgba(0, 242, 254, 0.35);
  --border-active: #00f2fe;

  --accent-cyan: #00f2fe;
  --accent-teal: #4facfe;
  --accent-emerald: #10b981;
  --accent-amber: #f59e0b;
  --accent-rose: #f43f5e;
  --accent-purple: #a855f7;

  --text-primary: #f8fafc;
  --text-secondary: #94a3b8;
  --text-muted: #64748b;
  --text-cyan: #38bdf8;

  --font-sans: 'Outfit', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  --font-mono: 'JetBrains Mono', monospace;

  --glass-blur: blur(16px);
  --sidebar-width: 440px;
  --header-height: 64px;
  --bottombar-height: 38px;
  --radius-sm: 6px;
  --radius-md: 10px;
  --radius-lg: 16px;
  --radius-full: 9999px;

  --shadow-glow: 0 0 25px rgba(0, 242, 254, 0.25);
  --shadow-panel: 0 20px 40px -15px rgba(0, 0, 0, 0.7);
}

*, *::before, *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  font-family: var(--font-sans);
  background-color: var(--bg-primary);
  color: var(--text-primary);
  overflow: hidden;
  height: 100vh;
  width: 100vw;
  user-select: none;
  -webkit-font-smoothing: antialiased;
}

/* App Layout */
#app-container {
  display: flex;
  flex-direction: column;
  width: 100vw;
  height: 100vh;
  background: radial-gradient(circle at 50% 20%, #111a2e 0%, #070a11 100%);
  position: relative;
}

/* Header */
header.app-header {
  height: var(--header-height);
  min-height: var(--header-height);
  background: rgba(10, 16, 29, 0.85);
  backdrop-filter: var(--glass-blur);
  border-bottom: 1px solid var(--border-subtle);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 20px;
  z-index: 50;
}

.brand-section {
  display: flex;
  align-items: center;
  gap: 14px;
}

.logo-badge {
  width: 38px;
  height: 38px;
  border-radius: var(--radius-md);
  background: linear-gradient(135deg, rgba(0,242,254,0.2) 0%, rgba(79,172,254,0.1) 100%);
  border: 1px solid var(--border-accent);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--accent-cyan);
  box-shadow: 0 0 15px rgba(0,242,254,0.2);
}

.brand-info h1 {
  font-size: 16px;
  font-weight: 700;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  color: var(--text-primary);
  display: flex;
  align-items: center;
  gap: 8px;
}

.brand-info h1 span.tag {
  font-size: 10px;
  font-weight: 600;
  padding: 2px 7px;
  border-radius: var(--radius-full);
  background: rgba(0,242,254,0.15);
  border: 1px solid rgba(0,242,254,0.4);
  color: var(--accent-cyan);
  letter-spacing: 0.05em;
}

.brand-info p {
  font-size: 11px;
  color: var(--text-muted);
  font-family: var(--font-mono);
}

/* Quick Tool Strip in Header */
.header-actions {
  display: flex;
  align-items: center;
  gap: 10px;
}

.btn-group {
  display: flex;
  align-items: center;
  background: rgba(15, 23, 42, 0.7);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-md);
  padding: 3px;
  gap: 2px;
}

.action-btn {
  background: transparent;
  border: none;
  color: var(--text-secondary);
  height: 32px;
  padding: 0 10px;
  border-radius: var(--radius-sm);
  font-size: 12px;
  font-weight: 500;
  cursor: pointer;
  display: flex;
  align-items: center;
  gap: 6px;
  transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  font-family: var(--font-sans);
}

.action-btn svg {
  width: 15px;
  height: 15px;
}

.action-btn:hover {
  color: var(--text-primary);
  background: rgba(255, 255, 255, 0.08);
}

.action-btn.active {
  background: rgba(0, 242, 254, 0.18);
  color: var(--accent-cyan);
  border: 1px solid rgba(0, 242, 254, 0.4);
}

.action-select {
  background: rgba(15, 23, 42, 0.8);
  border: 1px solid var(--border-subtle);
  color: var(--text-primary);
  height: 34px;
  padding: 0 10px;
  border-radius: var(--radius-sm);
  font-size: 12px;
  font-family: var(--font-sans);
  cursor: pointer;
  outline: none;
  transition: border-color 0.2s;
}

.action-select:focus, .action-select:hover {
  border-color: var(--border-accent);
}

/* Main Workspace */
.workspace {
  flex: 1;
  display: flex;
  position: relative;
  overflow: hidden;
}

/* 3D Canvas Container */
.viewport-wrapper {
  flex: 1;
  position: relative;
  height: 100%;
  width: 100%;
}

#three-canvas {
  width: 100%;
  height: 100%;
  display: block;
}

/* Viewport HUD Overlays */
.viewport-hud {
  position: absolute;
  top: 16px;
  left: 20px;
  display: flex;
  flex-direction: column;
  gap: 12px;
  pointer-events: none;
  z-index: 20;
}

.viewport-hud > * {
  pointer-events: auto;
}

/* Floating Camera Pill */
.camera-pills {
  display: flex;
  background: var(--bg-surface);
  backdrop-filter: var(--glass-blur);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-full);
  padding: 4px;
  gap: 3px;
  box-shadow: 0 8px 24px rgba(0,0,0,0.4);
}

.camera-pill-btn {
  background: transparent;
  border: none;
  color: var(--text-secondary);
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.04em;
  padding: 5px 12px;
  border-radius: var(--radius-full);
  cursor: pointer;
  transition: all 0.2s;
}

.camera-pill-btn:hover {
  color: var(--text-primary);
  background: rgba(255,255,255,0.06);
}

.camera-pill-btn.active {
  background: linear-gradient(135deg, #00f2fe 0%, #4facfe 100%);
  color: #04101e;
  box-shadow: 0 0 12px rgba(0,242,254,0.4);
}

/* Viewport Info Badge */
.stats-card-hud {
  background: var(--bg-surface);
  backdrop-filter: var(--glass-blur);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-md);
  padding: 10px 14px;
  font-family: var(--font-mono);
  font-size: 11px;
  line-height: 1.6;
  color: var(--text-secondary);
  box-shadow: var(--shadow-panel);
}

.stats-card-hud strong {
  color: var(--accent-cyan);
  font-weight: 600;
}

/* Floating Tools Bar bottom-left */
.viewport-tools {
  position: absolute;
  bottom: 16px;
  left: 20px;
  display: flex;
  gap: 8px;
  z-index: 20;
}

.tool-chip {
  background: var(--bg-surface);
  backdrop-filter: var(--glass-blur);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-md);
  padding: 7px 12px;
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 12px;
  color: var(--text-secondary);
  cursor: pointer;
  transition: all 0.2s;
}

.tool-chip:hover {
  color: var(--text-primary);
  border-color: var(--border-accent);
}

.tool-chip.active {
  border-color: var(--accent-cyan);
  background: rgba(0, 242, 254, 0.12);
  color: var(--accent-cyan);
}

/* Slicing Controls Flyout */
.slicing-panel {
  position: absolute;
  bottom: 60px;
  left: 20px;
  width: 320px;
  background: var(--bg-surface);
  backdrop-filter: var(--glass-blur);
  border: 1px solid var(--border-accent);
  border-radius: var(--radius-md);
  padding: 14px;
  display: flex;
  flex-direction: column;
  gap: 12px;
  box-shadow: var(--shadow-panel);
  z-index: 25;
  transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
}

.slicing-panel.hidden {
  opacity: 0;
  pointer-events: none;
  transform: translateY(10px);
}

.slicing-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 12px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--accent-cyan);
}

.slider-group {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.slider-label {
  display: flex;
  justify-content: space-between;
  font-size: 11px;
  color: var(--text-muted);
}

.slider-label span.val {
  color: var(--text-primary);
  font-family: var(--font-mono);
}

input[type="range"] {
  width: 100%;
  accent-color: var(--accent-cyan);
  background: rgba(255,255,255,0.1);
  height: 4px;
  border-radius: 2px;
  cursor: pointer;
}

/* Loading Overlay */
#loader-overlay {
  position: absolute;
  inset: 0;
  background: rgba(7, 10, 17, 0.92);
  backdrop-filter: blur(12px);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 100;
  transition: opacity 0.5s ease;
}

#loader-overlay.fade-out {
  opacity: 0;
  pointer-events: none;
}

.spinner-box {
  width: 60px;
  height: 60px;
  position: relative;
  margin-bottom: 20px;
}

.spinner-ring {
  position: absolute;
  inset: 0;
  border: 2px solid transparent;
  border-top-color: var(--accent-cyan);
  border-radius: 50%;
  animation: spin 1.2s cubic-bezier(0.5, 0, 0.5, 1) infinite;
}

.spinner-ring:nth-child(2) {
  border-top-color: var(--accent-teal);
  animation-delay: -0.3s;
  inset: 6px;
}

.spinner-ring:nth-child(3) {
  border-top-color: var(--accent-purple);
  animation-delay: -0.6s;
  inset: 12px;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loader-text {
  font-size: 14px;
  font-weight: 600;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  color: var(--text-primary);
  margin-bottom: 8px;
}

.loader-progress {
  width: 240px;
  height: 4px;
  background: rgba(255,255,255,0.1);
  border-radius: var(--radius-full);
  overflow: hidden;
  margin-bottom: 8px;
}

.loader-bar {
  height: 100%;
  width: 0%;
  background: linear-gradient(90deg, #00f2fe, #4facfe);
  border-radius: var(--radius-full);
  transition: width 0.15s ease;
}

.loader-status {
  font-size: 11px;
  font-family: var(--font-mono);
  color: var(--text-muted);
}

/* Sidebar */
aside.app-sidebar {
  width: var(--sidebar-width);
  height: 100%;
  background: var(--bg-surface);
  backdrop-filter: var(--glass-blur);
  border-left: 1px solid var(--border-subtle);
  display: flex;
  flex-direction: column;
  z-index: 40;
  box-shadow: -10px 0 30px rgba(0,0,0,0.4);
  transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
}

aside.app-sidebar.collapsed {
  transform: translateX(100%);
}

.sidebar-toggle-btn {
  position: absolute;
  top: 16px;
  right: calc(var(--sidebar-width) + 12px);
  width: 34px;
  height: 34px;
  background: var(--bg-surface);
  backdrop-filter: var(--glass-blur);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-md);
  color: var(--text-secondary);
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  z-index: 45;
  transition: all 0.2s;
}

.sidebar-toggle-btn:hover {
  color: var(--text-primary);
  border-color: var(--border-accent);
}

/* Sidebar Nav Tabs */
.sidebar-tabs {
  display: flex;
  border-bottom: 1px solid var(--border-subtle);
  background: rgba(10, 16, 29, 0.6);
  padding: 8px 12px 0;
  gap: 4px;
}

.tab-btn {
  background: transparent;
  border: none;
  color: var(--text-muted);
  font-size: 11px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  padding: 8px 12px;
  border-radius: var(--radius-sm) var(--radius-sm) 0 0;
  cursor: pointer;
  transition: all 0.2s;
  position: relative;
}

.tab-btn:hover {
  color: var(--text-primary);
}

.tab-btn.active {
  color: var(--accent-cyan);
  background: rgba(255, 255, 255, 0.04);
}

.tab-btn.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 2px;
  background: var(--accent-cyan);
  box-shadow: 0 0 8px var(--accent-cyan);
}

/* Tab Content */
.sidebar-content {
  flex: 1;
  overflow-y: auto;
  padding: 18px;
  display: flex;
  flex-direction: column;
  gap: 18px;
}

.sidebar-content::-webkit-scrollbar {
  width: 5px;
}

.sidebar-content::-webkit-scrollbar-thumb {
  background: rgba(255,255,255,0.1);
  border-radius: 4px;
}

.tab-pane {
  display: none;
  flex-direction: column;
  gap: 16px;
}

.tab-pane.active {
  display: flex;
}

/* Metrics Grid */
.metrics-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 10px;
}

.metric-card {
  background: rgba(13, 19, 34, 0.7);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-md);
  padding: 12px;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.metric-card .label {
  font-size: 10px;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--text-muted);
}

.metric-card .value {
  font-size: 18px;
  font-weight: 700;
  font-family: var(--font-mono);
  color: var(--text-primary);
}

.metric-card .sub {
  font-size: 10px;
  color: var(--text-cyan);
}

/* Section Title */
.panel-section-title {
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--text-muted);
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 4px;
}

/* Modules Cards */
.subsystem-list {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.subsystem-card {
  background: rgba(13, 19, 34, 0.6);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-md);
  padding: 12px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  cursor: pointer;
  transition: all 0.2s;
}

.subsystem-card:hover {
  background: rgba(20, 29, 50, 0.8);
  border-color: var(--border-accent);
  transform: translateX(3px);
}

.subsystem-left {
  display: flex;
  align-items: center;
  gap: 12px;
}

.subsystem-icon {
  width: 32px;
  height: 32px;
  border-radius: var(--radius-sm);
  background: rgba(0,242,254,0.1);
  color: var(--accent-cyan);
  display: flex;
  align-items: center;
  justify-content: center;
}

.subsystem-info h4 {
  font-size: 13px;
  font-weight: 600;
  color: var(--text-primary);
}

.subsystem-info p {
  font-size: 11px;
  color: var(--text-muted);
}

.subsystem-badge {
  font-size: 10px;
  font-family: var(--font-mono);
  padding: 3px 8px;
  border-radius: var(--radius-full);
  background: rgba(255,255,255,0.06);
  color: var(--text-secondary);
}

/* Search and Filter for BOM */
.bom-controls {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.search-input-box {
  position: relative;
  width: 100%;
}

.search-input-box input {
  width: 100%;
  background: rgba(13, 19, 34, 0.8);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-md);
  padding: 8px 12px 8px 34px;
  color: var(--text-primary);
  font-size: 12px;
  font-family: var(--font-sans);
  outline: none;
  transition: border-color 0.2s;
}

.search-input-box input:focus {
  border-color: var(--accent-cyan);
}

.search-input-box svg {
  position: absolute;
  left: 10px;
  top: 50%;
  transform: translateY(-50%);
  width: 15px;
  height: 15px;
  color: var(--text-muted);
}

.filter-chips {
  display: flex;
  gap: 6px;
  flex-wrap: wrap;
}

.filter-chip {
  background: rgba(255,255,255,0.05);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-full);
  padding: 3px 10px;
  font-size: 10px;
  font-weight: 600;
  text-transform: uppercase;
  color: var(--text-muted);
  cursor: pointer;
  transition: all 0.2s;
}

.filter-chip:hover {
  color: var(--text-primary);
}

.filter-chip.active {
  background: rgba(0,242,254,0.15);
  border-color: var(--accent-cyan);
  color: var(--accent-cyan);
}

/* BOM Table */
.bom-table-container {
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-md);
  overflow: hidden;
  background: rgba(10, 15, 27, 0.5);
  max-height: 480px;
  overflow-y: auto;
}

.bom-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 11px;
}

.bom-table th {
  background: rgba(13, 20, 36, 0.9);
  padding: 8px 10px;
  text-align: left;
  font-weight: 600;
  color: var(--text-muted);
  font-size: 10px;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  position: sticky;
  top: 0;
  border-bottom: 1px solid var(--border-subtle);
  z-index: 2;
}

.bom-table td {
  padding: 8px 10px;
  border-bottom: 1px solid rgba(255,255,255,0.04);
  color: var(--text-secondary);
  font-family: var(--font-mono);
}

.bom-table tr:hover {
  background: rgba(0, 242, 254, 0.08);
  cursor: pointer;
}

.bom-table tr.selected {
  background: rgba(0, 242, 254, 0.18);
  border-left: 3px solid var(--accent-cyan);
}

.bom-table tr.selected td {
  color: var(--text-primary);
}

.part-name-cell {
  font-family: var(--font-sans) !important;
  font-weight: 500;
  color: var(--text-primary) !important;
}

/* Parameters Table */
.params-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 11px;
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-md);
  overflow: hidden;
}

.params-table td {
  padding: 8px 12px;
  border-bottom: 1px solid rgba(255,255,255,0.04);
}

.params-table td.param-key {
  color: var(--text-muted);
  font-family: var(--font-mono);
  font-size: 10px;
}

.params-table td.param-val {
  color: var(--accent-cyan);
  font-family: var(--font-mono);
  font-weight: 600;
  text-align: right;
}

/* Drawings Gallery */
.gallery-grid {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.gallery-card {
  background: rgba(13, 19, 34, 0.6);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-md);
  overflow: hidden;
  cursor: pointer;
  transition: all 0.2s;
}

.gallery-card:hover {
  border-color: var(--border-accent);
  transform: translateY(-2px);
  box-shadow: 0 8px 20px rgba(0,0,0,0.4);
}

.gallery-card img {
  width: 100%;
  height: 140px;
  object-fit: cover;
  display: block;
  background: #000;
}

.gallery-card-info {
  padding: 10px;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.gallery-card-info h4 {
  font-size: 12px;
  font-weight: 600;
}

.gallery-card-info span {
  font-size: 10px;
  color: var(--text-muted);
}

/* Download / Export Cards */
.download-list {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.download-card {
  background: rgba(13, 19, 34, 0.6);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-md);
  padding: 12px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  text-decoration: none;
  color: inherit;
  transition: all 0.2s;
}

.download-card:hover {
  background: rgba(20, 29, 50, 0.8);
  border-color: var(--accent-cyan);
}

.download-card h4 {
  font-size: 12px;
  font-weight: 600;
  color: var(--text-primary);
}

.download-card p {
  font-size: 10px;
  color: var(--text-muted);
  font-family: var(--font-mono);
}

.download-icon {
  width: 28px;
  height: 28px;
  border-radius: var(--radius-sm);
  background: rgba(0, 242, 254, 0.1);
  color: var(--accent-cyan);
  display: flex;
  align-items: center;
  justify-content: center;
}

/* Image Modal */
.image-modal {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.88);
  backdrop-filter: blur(16px);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 200;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.25s ease;
}

.image-modal.open {
  opacity: 1;
  pointer-events: auto;
}

.modal-content {
  max-width: 90vw;
  max-height: 88vh;
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.modal-content img {
  max-width: 100%;
  max-height: 82vh;
  border-radius: var(--radius-md);
  box-shadow: 0 25px 50px rgba(0,0,0,0.8);
  border: 1px solid var(--border-accent);
}

.modal-close-btn {
  position: absolute;
  top: -40px;
  right: 0;
  background: transparent;
  border: none;
  color: var(--text-primary);
  font-size: 24px;
  cursor: pointer;
}

/* Bottom Bar */
footer.app-footer {
  height: var(--bottombar-height);
  min-height: var(--bottombar-height);
  background: rgba(10, 16, 29, 0.9);
  backdrop-filter: var(--glass-blur);
  border-top: 1px solid var(--border-subtle);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 20px;
  font-size: 11px;
  color: var(--text-muted);
  font-family: var(--font-mono);
  z-index: 50;
}

.footer-left {
  display: flex;
  align-items: center;
  gap: 16px;
}

.status-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--accent-emerald);
  box-shadow: 0 0 8px var(--accent-emerald);
  display: inline-block;
  margin-right: 6px;
}

.footer-right {
  display: flex;
  align-items: center;
  gap: 16px;
}

/* Toast Notification */
.toast-notice {
  position: fixed;
  bottom: 50px;
  left: 50%;
  transform: translateX(-50%) translateY(20px);
  background: rgba(15, 23, 42, 0.95);
  border: 1px solid var(--accent-cyan);
  box-shadow: 0 10px 25px rgba(0,0,0,0.5), 0 0 15px rgba(0,242,254,0.3);
  backdrop-filter: var(--glass-blur);
  padding: 8px 18px;
  border-radius: var(--radius-full);
  font-size: 12px;
  font-weight: 500;
  color: var(--text-primary);
  z-index: 300;
  opacity: 0;
  pointer-events: none;
  transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
}

.toast-notice.show {
  opacity: 1;
  transform: translateX(-50%) translateY(0);
}
